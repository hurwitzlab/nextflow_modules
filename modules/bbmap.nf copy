#!/usr/bin/env nextflow

// New BBMap-suite processes not yet in viral_inference_benchmark's bbmap.nf
// (which currently has bbwrap + pileup). Meant to merge into that same file.

// Trim adapters and low-quality bases from paired reads with bbduk
 process bbduk {
    container "${params.container__bbmap}"
    publishDir "${params.bbduk_outdir}", mode: 'copy'

    input:
        tuple val(sampleid), path(raw_r1), path(raw_r2)
        path(adapters_file)

    output:
        tuple val(sampleid), path("${sampleid}_bbduk_1.fastq"), path("${sampleid}_bbduk_2.fastq"), emit: clean_reads

    shell:
    '''
    bbduk.sh \
    in1=!{raw_r1} \
    in2=!{raw_r2} \
    out1=!{sampleid}_bbduk_1.fastq \
    out2=!{sampleid}_bbduk_2.fastq \
    ref=!{adapters_file} \
    ktrim=!{params.bbduk_ktrim} \
    k=!{params.bbduk_k} \
    mink=!{params.bbduk_mink} \
    hdist=!{params.bbduk_hdist} \
    !{params.bbduk_additional_flags}
    '''
}

// Compute assembly quality statistics (N50, contig counts, GC%) with stats.sh
 process bbstats {
    container "${params.container__bbmap}"
    publishDir "${params.bbstats_outdir}", mode: 'copy'

    input:
        tuple val(sampleid), path(contigs)

    output:
        tuple val(sampleid), path("${sampleid}_stats.tsv"), emit: assembly_stats

    shell:
    '''
    stats.sh \
    in=!{contigs} \
    format=6 \
    > !{sampleid}_stats.tsv
    '''
}
